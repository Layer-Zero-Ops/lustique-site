---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Bridal Makeup & Hair Portfolio — Pretoria | Lustique Co.";
const desc =
  "Real brides, real mornings in Pretoria — a gallery of recent bridal hair and makeup work, filterable by artist.";
---
<BaseLayout slug="portfolio.html" title={title} desc={desc} breadcrumb={[{ name: "Portfolio" }]}>

  <section class="page-hero">
    <span class="eyebrow">Portfolio</span>
    <h1>Real work. Real mornings.</h1>
    <p>
      Every image here is real work — never stock, never AI. Filter by artist to see each
      woman's hand; as each of our nine shares hers, her gallery fills in here.
    </p>
  </section>

  <section class="section"><div class="wrap">

    <div class="filters" id="artistFilters" role="group" aria-label="Filter portfolio by artist">
      <button type="button" class="active" data-filter="all">All artists</button>
    </div>

    <div class="gallery" id="gallery"></div>

    <div class="gallery-empty" id="galleryEmpty" hidden>
      <p class="lead"><span data-empty-name>This artist</span>'s portfolio is coming soon.</p>
      <p class="note">We add each artist's work as she shares it. In the meantime, browse our full gallery.</p>
      <button type="button" class="btn btn-ghost" data-reset>View all work</button>
    </div>

    <p id="galleryLoading" class="note center" style="margin-top:2rem;">Loading portfolio…</p>

    <p class="note center" style="margin-top:2rem;display:none;" id="galleryNote">
      Every photograph here is our own real work — never stock, never AI. Per-artist galleries
      arrive as each of our nine artists shares hers.
    </p>
  </div></section>

  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let's begin</span>
      <h2 class="reveal d1" style="margin-top:1rem;">Tell us about your day.</h2>
      <p class="reveal d2">
        Share a few details and we'll send a personalised quote — usually within 24 hours, often sooner.
      </p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var SUPABASE_URL = "https://ywoovdpnphcogwgoqhst.supabase.co";
      var ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3b292ZHBucGhjb2d3Z29xaHN0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEzNTI2MTUsImV4cCI6MjA5NjkyODYxNX0.hUxMUBrm8sKOj2E3Uv6OG5J1EYGPn4ToCF14y1OtgII";

      function storageUrl(path) {
        return SUPABASE_URL + "/storage/v1/object/public/Portfolio/" + path;
      }

      async function loadPortfolio() {
        var loading = document.getElementById("galleryLoading");
        var note    = document.getElementById("galleryNote");
        var gallery = document.getElementById("gallery");
        var filters = document.getElementById("artistFilters");

        try {
          var res = await fetch(
            SUPABASE_URL + "/rest/v1/portfolio_images?select=id,storage_path,position,artist_id,artists(id,name)&order=position.asc",
            { headers: { apikey: ANON_KEY, Authorization: "Bearer " + ANON_KEY } }
          );
          if (!res.ok) throw new Error("fetch failed");
          var images = await res.json();

          if (loading) loading.style.display = "none";
          if (note) note.style.display = "";

          if (!images.length) return;

          // Build artist filter buttons (preserve event delegation in site.js)
          var seen = new Map();
          images.forEach(function (img) {
            if (img.artists && !seen.has(img.artists.id)) {
              seen.set(img.artists.id, img.artists.name);
            }
          });
          seen.forEach(function (name, id) {
            var btn = document.createElement("button");
            btn.type = "button";
            btn.dataset.filter = id;
            btn.textContent = name;
            filters.appendChild(btn);
          });

          // Build gallery images
          gallery.innerHTML = images.map(function (img) {
            var artistName = img.artists && img.artists.name;
            var alt = artistName
              ? "Bridal hair and makeup by " + artistName + " — Lustique Co., Pretoria"
              : "Bridal hair and makeup portfolio — Lustique Co., Pretoria";
            return '<img class="gitem"'
              + ' src="' + storageUrl(img.storage_path) + '"'
              + ' alt="' + alt.replace(/"/g, "&quot;") + '"'
              + ' data-artist="' + (img.artist_id || "") + '"'
              + ' loading="lazy" decoding="async" width="900">';
          }).join("");

        } catch (e) {
          if (loading) loading.style.display = "none";
          if (note) note.style.display = "";
        }
      }

      loadPortfolio();
    })();
  </script>

</BaseLayout>
