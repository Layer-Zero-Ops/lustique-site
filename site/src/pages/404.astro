---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Page Not Found — Lustique Co.";
const desc = "This page slipped away — let's get you back.";
---
<BaseLayout slug="404.html" title={title} desc={desc}>

  <section class="page-hero hero-alt">
    <span class="eyebrow">404</span>
    <h1>This page slipped away.</h1>
    <p>The link may be old or mistyped — but your day’s still on. Let’s get you back.</p>
    <div class="form-group-inline justify-center">
      <a class="btn btn-primary" href="index.html">Back home</a>
      <a class="btn btn-ghost" href="quote.html">Get a quote</a>
    </div>
  </section>
</BaseLayout>
