---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabaseGet } from "../lib/supabase";

const title = "Journal — Bridal Beauty Advice | Lustique Co.";
const desc = "Honest, practical bridal hair and makeup advice from a Pretoria team.";

type BlogPost = {
  id: string;
  title: string;
  slug: string;
  excerpt: string | null;
  tags: string[];
  published_at: string | null;
};

const posts = await supabaseGet<BlogPost>(
  "blog_posts?select=id,title,slug,excerpt,tags,published_at&published=eq.true&order=published_at.desc"
);
---
<BaseLayout slug="blog.html" title={title} desc={desc}>

  <section class="page-hero">
    <span class="eyebrow">Journal</span>
    <h1>Notes for your big day</h1>
    <p>Honest, practical advice from a team that has spent hundreds of wedding mornings doing exactly this.</p>
  </section>

  <section class="section"><div class="wrap">
    <div class="cards">
      {posts.length > 0
        ? posts.map((post, i) => (
            <article class={`card reveal${i === 1 ? " d1" : i === 2 ? " d2" : ""}`} >
              <span class="eyebrow">{post.tags?.[0] ?? "Journal"}</span>
              <h3 >{post.title}</h3>
              <p class="card-excerpt">{post.excerpt}</p>
              <a class="card-link" href={`blog/${post.slug}.html`}>Read <span>→</span></a>
            </article>
          ))
        : (
          <article class="card reveal" >
            <span class="eyebrow">Journal</span>
            <h3 >Articles coming soon</h3>
            <p class="card-excerpt">Our journal is on its way — check back soon for honest advice from the Lustique team.</p>
          </article>
        )
      }
    </div>
  </div></section>

</BaseLayout>
