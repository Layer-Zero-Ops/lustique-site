---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import heroImg from "../assets/hero.jpg";
import resImg from "../assets/res.jpg";
import s1Img from "../assets/s1.jpg";
import s2Img from "../assets/s2.jpg";
import s3Img from "../assets/s3.jpg";
import t1Img from "../assets/t1.jpg";
import t2Img from "../assets/t2.jpg";
import t3Img from "../assets/t3.jpg";
import t4Img from "../assets/t4.jpg";
import { TESTIMONIALS } from "../data/site";
import { fetchGoogleReviews } from "../lib/googleReviews";

const title = "Bridal Makeup Artist Pretoria | Lustique Co. — Hair & Makeup";
const desc =
  "Pretoria's bridal hair and makeup team. Nine specialists, 40+ years combined experience, serving Gauteng and beyond since 2018. We travel to you on your wedding day.";

const heroHeadline = "Feel most like yourself.";
const heroSub =
  "For the bride who wants to look softly, unmistakably, unforgettably like herself — on the morning that matters most.";

// Real Google reviews when GOOGLE_PLACES_API_KEY/GOOGLE_PLACE_ID are configured (see SETUP.md);
// falls back to the curated static testimonials otherwise. Never fabricate either the reviews
// or the aggregateRating — both come straight from what Google's API actually returns.
const googleReviews = await fetchGoogleReviews();
const testimonials = googleReviews?.reviews.length
  ? googleReviews.reviews.map((r, i) => ({ id: `g${i}`, quote: r.text, attribution: `${r.authorName} — Google review` }))
  : TESTIMONIALS;
const testimonialsSub = googleReviews?.reviews.length
  ? `— ${googleReviews.rating.toFixed(1)}★ average from ${googleReviews.userRatingCount} real Google reviews`
  : "— real bride testimonials";
const businessJsonLdExtra = googleReviews ? {
  aggregateRating: { "@type": "AggregateRating", ratingValue: googleReviews.rating, reviewCount: googleReviews.userRatingCount },
  review: googleReviews.reviews.map((r) => ({
    "@type": "Review",
    reviewRating: { "@type": "Rating", ratingValue: r.rating, bestRating: 5 },
    author: { "@type": "Person", name: r.authorName },
    reviewBody: r.text,
    datePublished: r.publishTime,
  })),
} : undefined;
---
<BaseLayout slug="index.html" title={title} desc={desc} businessJsonLdExtra={businessJsonLdExtra}>

  <section class="hero" aria-label="Lustique Co. — bridal hair and makeup artistry">
    <Image class="hero-img" src={heroImg} alt="A Lustique bride on her wedding morning — softly lit, hair styled, looking quietly radiant" fetchpriority="high" loading="eager" widths={[640, 960, 1440, 1920]} sizes="100vw" formats={["avif", "webp"]} />
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <span class="eyebrow">Bridal Hair &amp; Makeup Artistry · Pretoria &amp; Beyond</span>
      <h1 class="hero-title display">{heroHeadline}</h1>
      <div class="hero-rating reveal" role="img" aria-label={`Rated ${googleReviews?.rating?.toFixed(1) ?? 5} out of 5 stars`}>
        <div class="stars">{"★".repeat(Math.round(googleReviews?.rating ?? 5))}{"☆".repeat(5 - Math.round(googleReviews?.rating ?? 5))}</div>
        {googleReviews && <span class="rating-sub">— ${googleReviews.userRatingCount} real Google reviews</span>}
      </div>
      <p class="hero-sub">{heroSub}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="pricing.html">Get your estimate</a>
        <a class="btn btn-light" href="portfolio.html">View the portfolio</a>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="wrap">
      <div class="trust-item">We travel to you on your wedding day</div>
      <div class="trust-item">Trials by appointment, <b>in&nbsp;studio</b></div>
      <div class="trust-item">Personal, from your trial to the final touch-up</div>
    </div>
  </section>

  <section class="section statement">
    <div class="wrap">
      <span class="eyebrow reveal">Who we are</span>
      <h2 class="reveal d1" style="margin-top:1rem;">The artist a bride chooses when she wants to feel most like herself.</h2>
      <p class="reveal d2">We are a team of nine bridal artists based in La Montagne, Pretoria, working as one quiet, capable presence on the morning of your wedding. Since 2018 we have made it our craft to enhance — never to mask — so that when you look in the mirror, you simply see yourself, on your most radiant day.</p>
      <p class="reveal d2">From your trial to the final touch-up, every detail is personal, calm, and considered. We count it a blessing to play a small part in your day.</p>
      <div class="quote-block reveal d3">
        <p class="lead">"Beauty begins the moment you decide to be yourself."</p>
        <cite>— Coco Chanel</cite>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--ivory);">
    <div class="wrap">
      <div class="services-head">
        <div><span class="eyebrow reveal">What we do</span><h2 class="reveal d1" style="margin-top:1rem;">Flawless. Elegant.<br>Unforgettable.</h2></div>
        <p class="reveal d2" style="max-width:34ch;color:#5c5048;">Every look is tailored to you — your features, your dress, the feeling of your day.</p>
      </div>
      <div class="cards">
        <article class="card reveal"><div class="card-media"><Photo src={s1Img} alt="Bridal makeup by Lustique Co." /></div><div class="card-body"><h3>Bridal Makeup</h3><p>A soft, lasting look built on flawless skin — from natural radiance to timeless glamour, made to last from "I do" to the last dance.</p><a class="card-link" href="services.html">Explore makeup <span>→</span></a></div></article>
        <article class="card reveal d1"><div class="card-media"><Photo src={s2Img} alt="Bridal hair styling by Lustique Co." /></div><div class="card-body"><h3>Bridal Hair</h3><p>From romantic soft curls to elegant updos, styled to complement your features, your dress and the spirit of your celebration.</p><a class="card-link" href="services.html">Explore hair <span>→</span></a></div></article>
        <article class="card reveal d2"><div class="card-media"><Photo src={s3Img} alt="A bridal party styled by Lustique Co." /></div><div class="card-body"><h3>The Whole Party</h3><p>Bridesmaids, mothers, flower girls and guests — beautifully cohesive, individually considered, calmly choreographed on the day.</p><a class="card-link" href="pricing.html">Explore packages <span>→</span></a></div></article>
      </div>
    </div>
  </section>

  <section class="section team">
    <div class="wrap team-grid">
      <div class="team-collage reveal"><Photo src={t1Img} alt="A Lustique artist styling a bride" /><Photo src={t2Img} alt="Bridal hair detail" /><Photo src={t3Img} alt="Bridal makeup detail" /><Photo src={t4Img} alt="A Lustique bride on her wedding morning" /></div>
      <div class="team-copy">
        <span class="eyebrow reveal">The Lustique team</span>
        <h2 class="reveal d1">Nine artists.<br>One quiet morning at a time.</h2>
        <p class="reveal d2">Lustique is no longer one pair of hands — it is a team of nine bridal artists who move as one. Whoever joins you on your day brings the same calm, the same standard, the same care.</p>
        <p class="reveal d2">We allocate the right artists for your wedding so you never have to. You simply get the Lustique standard, every time.</p>
        <div class="stat-row reveal d3">
          <div class="stat"><b>9</b><span>Artists</span></div>
          <div class="stat"><b>40+</b><span>Years combined</span></div>
          <div class="stat"><b>2018</b><span>Since</span></div>
        </div>
        <div style="margin-top:2rem;" class="reveal d3"><a class="btn btn-ghost" href="team.html">Meet the team</a></div>
      </div>
    </div>
  </section>

  <section class="section pricing">
    <div class="wrap">
      <div class="pricing-head">
        <span class="eyebrow reveal">Transparent pricing</span>
        <h2 class="reveal d1">Know your investment before you enquire.</h2>
        <p class="reveal d2">No vague ranges, no "request a quote to find out." See clear starting prices, then build a personalised estimate in under a minute.</p>
      </div>
      <div class="price-grid">
        <div class="price reveal"><small>Solo Bride · trial + day</small><div class="amt"><sup>from R</sup>2 690</div></div>
        <div class="price reveal d1"><small>Bridesmaid · makeup</small><div class="amt"><sup>R</sup>550</div></div>
        <div class="price reveal d2"><small>Mother · makeup</small><div class="amt"><sup>R</sup>500</div></div>
        <div class="price reveal d3"><small>Bridal hair</small><div class="amt"><sup>from R</sup>495</div></div>
      </div>
      <div class="pricing-foot">
        <p>Free travel within 40 km round trip of our La Montagne studio · R7/km beyond · prices scale with hair length</p>
        <a class="btn btn-light reveal" href="pricing.html">See full pricing &amp; estimate →</a>
      </div>
    </div>
  </section>

  <section class="section testi">
    <div class="wrap">
      <div class="stars reveal">{"★".repeat(Math.round(googleReviews?.rating ?? 5))}{"☆".repeat(5 - Math.round(googleReviews?.rating ?? 5))}</div>
      <div class="testi-slider reveal d1">
        {testimonials.map((t, i) => (
          <div class={`testi-slide${i === 0 ? " active" : ""}`}>
            <p class="lead">"{t.quote}"</p>
            <cite>{t.attribution}</cite>
          </div>
        ))}
      </div>
      <div class="testi-dots"></div>
      <div class="sub reveal d2">{testimonialsSub}</div>
    </div>
  </section>

  <section class="section" style="background:var(--ivory);">
    <div class="wrap res-grid">
      <div class="res-copy">
        <span class="eyebrow reveal">For your big day</span>
        <h2 class="reveal d1">Free guides, from us to you.</h2>
        <p class="reveal d2">A 30-day bridal skin-prep plan, a wedding-morning timeline, and more — thoughtful resources to help your day feel calm and considered. Yours, free.</p>
        <a class="btn btn-primary reveal d2" href="guides.html">Browse the guides</a>
      </div>
      <div class="res-media reveal d1"><Photo src={resImg} alt="A calm Lustique bridal morning" /></div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let's begin</span>
      <h2 class="reveal d1" style="margin-top:1rem;">Tell us about your day.</h2>
      <p class="reveal d2">Share a few details and we'll send a personalised quote — usually within 24 hours, often sooner.</p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>

</BaseLayout>
