---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabaseGet } from "../../lib/supabase";
import { SITE, OG_IMG } from "../../data/site";

type BlogPost = {
  id: string;
  title: string;
  slug: string;
  excerpt: string | null;
  body: string;
  cover_url: string | null;
  published_at: string | null;
  updated_at: string;
};

export async function getStaticPaths() {
  const posts = await supabaseGet<{ slug: string }>(
    "blog_posts?select=slug&published=eq.true"
  );
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const results = await supabaseGet<BlogPost>(
  `blog_posts?select=id,title,slug,excerpt,body,cover_url,published_at,updated_at&slug=eq.${encodeURIComponent(slug!)}&published=eq.true&limit=1`
);
const post = results[0];

if (!post) {
  return Astro.redirect("/blog.html", 302);
}

const pubDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString("en-ZA", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const paragraphs = post.body
  ? post.body.split(/\n\n+/).filter((p) => p.trim())
  : [];

const postUrl = `${SITE}/blog/${slug}.html`;
const postImage = post.cover_url ?? OG_IMG;
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt ?? undefined,
  image: postImage,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  datePublished: post.published_at ?? post.updated_at,
  dateModified: post.updated_at,
  author: { "@type": "Person", name: "Zandeline Kemp" },
  publisher: { "@id": SITE + "/" },
};
---
<BaseLayout
  slug={`blog/${slug}.html`}
  title={`${post.title} | Lustique Co.`}
  desc={post.excerpt ?? ""}
  breadcrumb={[{ name: "Journal", item: "https://lustiqueco.co.za/blog.html" }, { name: post.title }]}
  ogImage={postImage}
  jsonld={blogPostingJsonLd}
>

  <section class="page-hero">
    <span class="eyebrow">Journal</span>
    <h1>{post.title}</h1>
    {post.excerpt && <p>{post.excerpt}</p>}
    {pubDate && <p class="note" >{pubDate}</p>}
  </section>

  <section class="section"><div class="wrap prose">
    {paragraphs.length > 0
      ? paragraphs.map((para) => <p>{para}</p>)
      : <p>This article is coming soon.</p>
    }
  </div></section>

  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let's begin</span>
      <h2 class="reveal d1" >Tell us about your day.</h2>
      <p class="reveal d2">Share a few details and we'll send a personalised quote — usually within 24 hours, often sooner.</p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>

</BaseLayout>
