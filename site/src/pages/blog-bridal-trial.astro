---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, OG_IMG } from "../data/site";
const title = "What to Expect at Your Bridal Trial | Lustique Co.";
const desc = "How to get the most from your bridal hair and makeup trial.";
const jsonld = {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: "What to Expect at Your Bridal Trial",
  description: desc, image: OG_IMG, url: SITE + "/blog-bridal-trial.html",
  mainEntityOfPage: { "@type": "WebPage", "@id": SITE + "/blog-bridal-trial.html" },
  author: { "@type": "Person", name: "Zandeline Kemp" }, publisher: { "@id": SITE + "/" },
};
---
<BaseLayout slug="blog-bridal-trial.html" title={title} desc={desc} jsonld={jsonld} breadcrumb={[{ name: "Journal", item: SITE + "/blog.html" }, { name: "What to Expect at Your Bridal Trial" }]}>

  
  <section class="page-hero">
    <span class="eyebrow">Journal · Trials</span>
    <h1>What to Expect at Your Bridal Trial</h1>
    <p>How to get the most from the most important appointment before your wedding.</p>
  </section>
  <section class="section"><div class="wrap prose">
    <p>The trial is the heart of the bridal beauty experience. It’s a relaxed, by-appointment session at our studio where we shape your look together — long before the big day.</p>
    <h2>Bring inspiration</h2>
    <p>A handful of images (Pinterest or Instagram), your hair accessories or veil, and an idea of your dress neckline all help us tailor the look.</p>
    <h2>Come prepared</h2>
    <p>Arrive with clean, moisturised, makeup-free skin. Tell us about any allergies or sensitivities so we can patch-test and choose the right products.</p>
    <h2>Speak up</h2>
    <p>This is the time to refine — lighter, softer, more defined. We’d far rather adjust now than on the morning. By the end, it should feel unmistakably <em>you</em>.</p>
    <h2>After the trial</h2>
    <p>We note everything — products, shades, the exact look — so your wedding morning is calm and certain.</p>
    <p>Ready to begin? <a href="quote.html">Request your quote</a> and we’ll plan your trial.</p>
  </div></section>
  
  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let’s begin</span>
      <h2 class="reveal d1" style="margin-top:1rem;">Tell us about your day.</h2>
      <p class="reveal d2">Share a few details and we’ll send a personalised quote — usually within 24 hours, often sooner.</p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>
</BaseLayout>
