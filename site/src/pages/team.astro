---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabaseGet } from "../lib/supabase";

const title = "The Team — Lustique Co.";
const desc = "Meet the nine bridal artists of Lustique Co. — 40+ years of combined experience.";

type Artist = {
  id: string;
  name: string;
  specialisms: string[];
  photo_url: string | null;
};

const rawArtists = await supabaseGet<Artist>(
  "artists?select=id,name,specialisms,photo_url&active=eq.true"
);
// Zandeline (founder) always first, rest alphabetical — only show artists with a photo
const withPhoto = rawArtists.filter(a => a.photo_url);
const artists = [
  ...withPhoto.filter(a => a.name.toLowerCase() === "zandeline"),
  ...withPhoto.filter(a => a.name.toLowerCase() !== "zandeline").sort((a, b) => a.name.localeCompare(b.name)),
];

function specialismLabel(specialisms: string[]): string {
  const has = (s: string) => specialisms?.includes(s);
  if (has("bridal-hair") && has("bridal-makeup")) return "Bridal Hair & Makeup";
  if (has("bridal-makeup")) return "Bridal Makeup";
  if (has("bridal-hair")) return "Bridal Hair";
  return "Bridal Artistry";
}
---
<BaseLayout slug="team.html" title={title} desc={desc} breadcrumb={[{ name: "The Team" }]}>

  <section class="page-hero">
    <span class="eyebrow">The Team</span>
    <h1>Nine artists. One quiet<br />morning at a time.</h1>
    <p>
      Together our nine bridal artists bring over 40 years of combined experience.
      Whoever joins you on your day brings the same calm, the same standard, the same care.
    </p>
  </section>

  <section class="section" style="padding-top:3rem"><div class="wrap">
    <div class="artist-grid">
      {artists.map((a, i) => (
        <div class={`artist reveal${["", " d1", " d2"][i % 3]}`}>
          {a.photo_url
            ? <img src={a.photo_url} alt={`${a.name} — Lustique Co. bridal artist`} class="artist-photo" loading="lazy" decoding="async" width="480" height="640">
            : <div class="ph"></div>
          }
          <h3>{a.name}</h3>
          <div class="role">{specialismLabel(a.specialisms)}</div>
        </div>
      ))}
    </div>
    <p class="note center" style="margin-top:2.4rem;max-width:60ch;margin-inline:auto;">
      Each artist's portfolio will live as a highlight on our Instagram. We allocate the right
      artists for your wedding by date and party size — so you simply get the Lustique standard,
      every time.
    </p>
  </div></section>

  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let's begin</span>
      <h2 class="reveal d1" style="margin-top:1rem;">Tell us about your day.</h2>
      <p class="reveal d2">
        Share a few details and we'll send a personalised quote — usually within 24 hours, often sooner.
      </p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>

</BaseLayout>
