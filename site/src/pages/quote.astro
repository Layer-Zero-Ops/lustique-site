---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TURNSTILE_SITE_KEY } from "../data/site";
const title = "Get a Quote — Lustique Co.";
const desc = "Tell us about your wedding day and receive a personalised bridal hair and makeup quote within 24 hours.";
---
<BaseLayout slug="quote.html" title={title} desc={desc}>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    (function() {
      try {
        var p = new URLSearchParams(location.search);
        var v = p.get('ref') || p.get('utm_source');
        if (v) sessionStorage.setItem('lustique_referral_source', v.slice(0, 80));
      } catch (e) { /* best-effort only */ }
    })();
  </script>

  <section class="page-hero">
    <span class="eyebrow">Get a Quote</span>
    <h1>Tell us about your day.</h1>
    <p>Every bride deserves a look as unique as her story. Build your estimate below — it updates live — then send it through for a personalised quote within 24 hours.</p>
    </div>
  </section>
  <section class="section"><div class="wrap form-wrap">
    <div class="estimate-box" id="estimateBar">
      <div><div class="estimate-label">Your live estimate</div><div id="estimateSub" class="estimate-sub">Updates as you fill in the form</div></div>
      <div class="amt" id="estimateAmount">from R 2 890</div>
    </div>
    <form id="quoteForm">
      <input type="text" name="company" id="hp_company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
      <div class="form-step reveal"><h3>Your occasion</h3><p class="step-sub">Choose your occasion and we'll tailor the estimator and quote to you.</p>
        <div class="field"><label for="occasion">What are we creating for?</label><select id="occasion" required><option value="wedding">Wedding</option><option value="matric">Matric farewell</option><option value="event">Event</option></select></div>
      </div>
      <div class="form-step reveal"><h3>About you</h3><p class="step-sub">Let’s start with the star of the show.</p>
        <div class="field-row"><div class="field"><label for="fName">First name</label><input id="fName" placeholder="Your name" required></div><div class="field"><label for="lName">Last name</label><input id="lName" placeholder="Surname" required></div></div>
        <div class="field-row"><div class="field"><label for="email">Email</label><input type="email" id="email" placeholder="you@email.com" required></div><div class="field"><label for="phone">Mobile / WhatsApp</label><input id="phone" placeholder="067 000 0000" required></div></div>
        <div class="field"><label for="source">How did you hear about us?</label><select id="source" required><option>Instagram</option><option>Google</option><option>A friend / past bride</option><option>TikTok</option><option>Facebook</option><option>Other</option></select></div>
      </div>
      <div class="form-step reveal" id="weddingDayFields"><h3>Your big day</h3><p class="step-sub">So we can reserve the date and work out the travel from our La Montagne studio.</p>
        <div class="field"><label for="weddingDate">Wedding date</label><input type="date" id="weddingDate" required></div>
        <div class="field relative">
          <label for="venueInput">Venue name or address <span class="field-helper">(start typing — we’ll search for it)</span></label>
          <input id="venueInput" placeholder="e.g. Red Ivory Estate, or a street address" autocomplete="off" required>
          <div id="venueSuggestions" class="venue-suggestions"></div>
        </div>
        <button type="button" class="btn btn-ghost" id="checkTravel" >Find venue on map</button>
        <div id="venueMap" class="venue-map"></div>
        <div id="mapHint" class="map-hint">
          <strong class="map-hint-strong">📍 Pick a suggestion above for the exact pin.</strong> Didn’t see it? Drag the pin on the map to your venue and the travel fee updates instantly.
        </div>
        <p class="note" id="travelResult" >We travel from La Montagne, Pretoria — first 40 km round trip is free, then R7/km.</p>
        <div class="field form-hidden" id="bandWrap"><label for="travelBand">Distance band (fallback)</label><select id="travelBand"><option value="studio">Within 20 km one-way / 40 km round trip (free)</option><option value="mid">30–80 km</option><option value="far">80–150 km</option><option value="veryfar">150–200 km</option><option value="destination">Over 200 km / destination</option></select></div>
      </div>
      <div id="weddingFields">
      <div class="form-step reveal"><h3>The bride</h3><p class="step-sub">Choose what you'd like for yourself — lashes and a touch-up kit included whenever makeup is booked.</p>
        <div class="form-group-inline">
          <label class="inline-checkbox-label"><input type="checkbox" id="brideWantsMakeup" checked class="input-auto"> Makeup</label>
          <label class="inline-checkbox-label"><input type="checkbox" id="brideWantsHair" checked class="input-auto"> Hair</label>
          <label class="inline-checkbox-label"><input type="checkbox" id="brideWantsTrial" checked class="input-auto"> Include a trial</label>
        </div>
        <div class="field" id="brideHairLenWrap"><label for="brideHairLen">Bride’s hair length</label><select id="brideHairLen"><option value="short">Short (chin)</option><option value="medium" selected>Medium (shoulder)</option><option value="long">Long (mid-back)</option><option value="xlong">X-Long (pantyline)</option></select></div>
      </div>
      <div class="form-step reveal"><h3>Your bridal party</h3><p class="step-sub">Makeup and hair are priced separately — so tell us exactly who needs what, and only pay for that.</p>
        <p class="section-subhead">Bridesmaids</p>
        <div class="field-row"><div class="field"><label for="bmMakeup">Need makeup</label><select id="bmMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option></select></div><div class="field"><label for="bmHair">Need hair</label><select id="bmHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option></select></div></div>
        <p class="section-subhead">Mothers (of the bride &amp; groom)</p>
        <div class="field-row"><div class="field"><label for="momMakeup">Need makeup</label><select id="momMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div><div class="field"><label for="momHair">Need hair</label><select id="momHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div></div>
        <p class="section-subhead">Flower girls</p>
        <div class="field-row"><div class="field"><label for="fgAge">Age</label><select id="fgAge"><option value="under">Under 12</option><option value="over">12 and over</option></select></div><div class="field"><label for="fgMakeup">Need makeup</label><select id="fgMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div></div>
        <div class="field-row"><div class="field"><label for="fgHair">Flower girls — need hair</label><select id="fgHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option></select></div><div class="field"><label for="fgHairLen">Flower girls’ hair length</label><select id="fgHairLen"><option value="short">Short (chin)</option><option value="medium" selected>Medium (shoulder)</option><option value="long">Long (mid-back)</option><option value="xlong">X-Long (pantyline)</option></select></div></div>
        <p class="section-subhead">Other guests</p>
        <div class="field-row"><div class="field"><label for="guestMakeup">Need makeup</label><select id="guestMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div><div class="field"><label for="guestHair">Need hair</label><select id="guestHair"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div></div>
        <div role="group" aria-labelledby="partyHairLabel" id="partyHairWrap" >
          <p id="partyHairLabel" class="field-label">Your bridal party’s hair length <span class="field-helper">(of those needing hair — we’ll confirm each at the trial)</span></p>
          <div class="form-group-box">
            <p class="section-subhead-sm">Bridesmaids</p>
            <p class="note" >Place the <span id="bmHairHeadCount">0</span> looks that need hair, by length:</p>
            <div class="field-row"><div class="field"><label for="bmHairLenShort">Short</label><input type="number" id="bmHairLenShort" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="bmHairLenMedium">Medium</label><input type="number" id="bmHairLenMedium" min="0" inputmode="numeric" value="0"></div></div>
            <div class="field-row"><div class="field"><label for="bmHairLenLong">Long</label><input type="number" id="bmHairLenLong" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="bmHairLenXlong">X-Long</label><input type="number" id="bmHairLenXlong" min="0" inputmode="numeric" value="0"></div></div>
            <p class="note" id="bmLengthsCounter" ></p>
          </div>
          <div class="form-group-box">
            <p class="section-subhead-sm">Mothers (of the bride &amp; groom)</p>
            <p class="note" >Place the <span id="momHairHeadCount">0</span> looks that need hair, by length:</p>
            <div class="field-row"><div class="field"><label for="momHairLenShort">Short</label><input type="number" id="momHairLenShort" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="momHairLenMedium">Medium</label><input type="number" id="momHairLenMedium" min="0" inputmode="numeric" value="0"></div></div>
            <div class="field-row"><div class="field"><label for="momHairLenLong">Long</label><input type="number" id="momHairLenLong" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="momHairLenXlong">X-Long</label><input type="number" id="momHairLenXlong" min="0" inputmode="numeric" value="0"></div></div>
            <p class="note" id="momLengthsCounter" ></p>
          </div>
          <div class="form-group-box">
            <p class="section-subhead-sm">Other guests</p>
            <p class="note" >Place the <span id="guestHairHeadCount">0</span> looks that need hair, by length:</p>
            <div class="field-row"><div class="field"><label for="guestHairLenShort">Short</label><input type="number" id="guestHairLenShort" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="guestHairLenMedium">Medium</label><input type="number" id="guestHairLenMedium" min="0" inputmode="numeric" value="0"></div></div>
            <div class="field-row"><div class="field"><label for="guestHairLenLong">Long</label><input type="number" id="guestHairLenLong" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="guestHairLenXlong">X-Long</label><input type="number" id="guestHairLenXlong" min="0" inputmode="numeric" value="0"></div></div>
            <p class="note" id="guestLengthsCounter" ></p>
          </div>
        </div>
        <div class="field" ><label for="requestedArtists">Additional artist for a faster morning? <span class="field-helper">(optional — R850 each, only if your timeline is tight. Larger parties already include the help.)</span></label><select id="requestedArtists"><option value="0">No, the team is enough</option><option value="1">Yes — 1 extra artist</option><option value="2">Yes — 2 extra artists</option></select></div>
      </div>
      </div>
      <div class="form-step reveal form-hidden" id="eventFields"><h3>Who needs makeup &amp; hair?</h3><p class="step-sub">Tell us how many people need each — only pay for what you book.</p>
        <div class="field"><label for="eventAt">Where should we meet you?</label><select id="eventAt"><option value="venue">At the venue — travel fee applies</option><option value="studio">At the Lustique studio, La Montagne — no travel fee</option></select></div>
        <p class="note" >For groups of 3+, we recommend meeting at your venue — it's more comfortable for everyone, and we come to you.</p>
        <div class="field-row"><div class="field"><label for="evMakeup">Need makeup</label><select id="evMakeup"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option></select></div><div class="field"><label for="evHair">Need hair</label><select id="evHair"><option selected>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option></select></div></div>
        <div role="group" aria-labelledby="evHairLabel" id="evHairWrap" class="form-hidden">
          <p id="evHairLabel" class="field-label">Hair length breakdown <span class="field-helper">(choose the length for each person getting hair styling)</span></p>
          <p class="note" >Place the <span id="evHairHeadCount">0</span> looks that need hair, by length:</p>
          <div class="field-row"><div class="field"><label for="evLenShort">Short</label><input type="number" id="evLenShort" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="evLenMedium">Medium</label><input type="number" id="evLenMedium" min="0" inputmode="numeric" value="0"></div></div>
          <div class="field-row"><div class="field"><label for="evLenLong">Long</label><input type="number" id="evLenLong" min="0" inputmode="numeric" value="0"></div><div class="field"><label for="evLenXlong">X-Long</label><input type="number" id="evLenXlong" min="0" inputmode="numeric" value="0"></div></div>
          <p class="note" id="evLengthsCounter" ></p>
        </div>
      </div>
      <div class="form-step reveal"><h3>Your vision</h3><p class="step-sub">The more you share, the more we can tailor your day.</p>
        <div class="field"><label for="style">Style</label><select id="style"><option>Natural &amp; soft</option><option>Soft glam</option><option>Full glam</option><option>Editorial</option><option>Boho</option><option>Not sure yet — guide me</option></select></div>
        <div class="field"><label for="inspo">Inspiration link (Pinterest / Instagram)</label><input id="inspo" placeholder="Paste a link — optional"></div>
        <div class="field"><label for="message">Anything else we should know? (skin notes, timings, special requests)</label><textarea id="message" rows="4" placeholder="Tell us anything that helps us prepare…"></textarea></div>
        <div id="estimateBreakdown" class="estimate-detail"></div>
        <div id="promoRow" class="form-hidden"><label class="inline-checkbox-label"><input type="checkbox" id="promoToggle" checked class="input-auto"> <span id="promoToggleLabel">Apply the current offer to my estimate</span></label></div>
        <div class="consent-section">
          <label class="field-label-start">
            <input type="checkbox" id="consentCheck" class="input-auto">
            <span>I consent to Lustique Co. processing my personal information to prepare my quote and contact me about my enquiry, as described in the <a href="privacy.html" target="_blank" class="consent-text">Privacy Policy</a>. (Required)</span>
          </label>
        </div>
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} ></div>
        <button type="button" class="btn btn-primary btn-full" id="sendEnquiry">Request to Book</button>
        <noscript><p class="note center" >This live form needs JavaScript to send. To enquire right now, email <a href="mailto:info@lustiqueco.co.za">info@lustiqueco.co.za</a> with your date, venue and party — we reply within 24 hours.</p></noscript>
        <p class="note center status-error" id="enquiryStatus" role="alert"></p>
        <p class="note center" >We reply within 24 hours, often sooner. <strong>Blessings, The Lustique Cosmetology Team.</strong></p>
      </div>
    </form>
  </div></section>
  <script>import "../scripts/estimator.ts";</script>
  <script>import "../scripts/enquiry.ts";</script>
</BaseLayout>
