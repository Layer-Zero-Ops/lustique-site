---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import s1Img from "../assets/s1.jpg";
import s2Img from "../assets/s2.jpg";
import s3Img from "../assets/s3.jpg";
import { SITE } from "../data/site";

const title = "Bridal Makeup & Hair Artist Pretoria | Lustique Co. Services";
const desc =
  "Professional bridal makeup artists and hair stylists in Pretoria. From soft glow to timeless glam — tailored to you, built to last. Matric, editorial, engagement and more. Serving Gauteng since 2018.";

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service", "@id": SITE + "/services.html#bridal-makeup",
      name: "Bridal Makeup", provider: { "@id": SITE + "/" },
      description: "Customised bridal makeup — soft glow or bold glam — using premium, long-wearing, photography-friendly products. From R850.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#bridal-hair",
      name: "Bridal Hair Styling", provider: { "@id": SITE + "/" },
      description: "Romantic curls, elegant updos or effortless waves styled to hold all day. From R495.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#matric",
      name: "Matric Farewell Makeup", provider: { "@id": SITE + "/" },
      description: "A standout look for her big night — glam that photographs beautifully and lasts through every dance. R750.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#editorial",
      name: "Editorial & Photoshoot Makeup", provider: { "@id": SITE + "/" },
      description: "Camera-ready makeup for editorial, brand and personal shoots. Lashes included on photoshoots. From R600.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#engagement",
      name: "Engagement & Maternity Shoot Makeup", provider: { "@id": SITE + "/" },
      description: "Soft, radiant looks for engagement and maternity shoots. From R650.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#pageant",
      name: "Pageant & Stage Makeup", provider: { "@id": SITE + "/" },
      description: "Bold, long-wearing makeup built for stage lighting and the camera. From R950.",
      areaServed: "Gauteng", serviceType: "BeautyTreatment",
    },
    {
      "@type": "Service", "@id": SITE + "/services.html#group-lessons",
      name: "Group Makeup Lessons", provider: { "@id": SITE + "/" },
      description: "Learn to do your own makeup — groups of 6+, at Bez Ranch or on location. Includes a brush-set goodie bag. From R600 per person.",
      areaServed: "Gauteng", serviceType: "EducationalOccupationalProgram",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
        { "@type": "ListItem", position: 2, name: "Services", item: SITE + "/services.html" },
      ],
    },
  ],
};
---
<BaseLayout slug="services.html" title={title} desc={desc} jsonld={serviceJsonLd}>

  <section class="page-hero">
    <span class="eyebrow">What we do</span>
    <h1>Flawless. Elegant. Unforgettable.</h1>
    <p>
      From the bride and her party to special-occasion glamour, every look is
      tailored — with quality, care, and a personal touch.
    </p>
  </section>

  <section class="section"><div class="wrap">
    <div class="center section-divider reveal">
      <span class="eyebrow reveal">The wedding day</span>
      <h2 class="reveal d1" >Bridal hair &amp; makeup</h2>
    </div>
    <div class="cards">
      <article class="card reveal"><div class="card-media"><Photo src={s1Img} alt="Bridal makeup by Lustique Co." /></div><div class="card-body"><h3>Bridal Makeup</h3><p>Enhance your natural beauty with a customised look — soft glow or bold glam — using premium, long-wearing, photography-friendly products.</p><p class="card-price">from R850</p></div></article>
      <article class="card reveal d1"><div class="card-media"><Photo src={s2Img} alt="Bridal hair by Lustique Co." /></div><div class="card-body"><h3>Bridal Hair</h3><p>Romantic curls, elegant updos, or effortless waves — styled to complement your features, dress and theme, and to hold all day.</p><p class="card-price">from R495</p></div></article>
      <article class="card reveal d2"><div class="card-media"><Photo src={s3Img} alt="A bridal party styled by Lustique Co." /></div><div class="card-body"><h3>The Whole Party</h3><p>Bridesmaids, mothers, flower girls and guests — cohesive yet individual, calmly choreographed so everyone is ready and glowing.</p><p class="card-price">see pricing</p></div></article>
    </div>
  </div></section>

  <section class="section section-alt"><div class="wrap">
    <div class="center section-divider">
      <span class="eyebrow reveal">Beyond bridal</span>
      <h2 class="reveal d1" >For every special occasion</h2>
      <p class="reveal d2 maxw-md">
        We do any event — and group lessons too.
      </p>
    </div>
    <div class="cards">
      <article class="card reveal" ><span class="eyebrow">01</span><h3 >Matric Farewell</h3><p>A standout look for her big night — glam that photographs beautifully and lasts through every dance.</p><p class="card-price">R750</p></article>
      <article class="card reveal" ><span class="eyebrow">02</span><h3 >Editorial &amp; Photoshoot</h3><p>Camera-ready makeup for editorial, brand and personal shoots. Lashes included on photoshoots.</p><p class="card-price">from R600</p></article>
      <article class="card reveal" ><span class="eyebrow">03</span><h3 >Engagement &amp; Maternity</h3><p>Soft, radiant looks for engagement and maternity shoots — natural, warm, and you.</p><p class="card-price">from R650*</p></article>
      <article class="card reveal" ><span class="eyebrow">04</span><h3 >Corporate &amp; Events</h3><p>Polished makeup for corporate events, galas and celebrations, for one face or many.</p><p class="card-price">from R650*</p></article>
      <article class="card reveal" ><span class="eyebrow">05</span><h3 >Pageant &amp; Stage</h3><p>Bold, long-wearing makeup built for stage lighting and the camera.</p><p class="card-price">from R950*</p></article>
      <article class="card reveal" ><span class="eyebrow">06</span><h3 >Group Lessons</h3><p>Learn to do your own makeup with us — groups of 6+, at Bez Ranch (Kameelfontein) or on location. Includes a brush-set goodie bag.</p><p class="card-price">from R600 pp</p></article>
    </div>
    <p class="note center" >* Indicative — final pricing to be confirmed with our team.</p>
  </div></section>

  <section class="section cta-band">
    <div class="wrap">
      <span class="eyebrow reveal">Let's begin</span>
      <h2 class="reveal d1" >Tell us about your day.</h2>
      <p class="reveal d2">
        Share a few details and we'll send a personalised quote — usually within 24 hours, often sooner.
      </p>
      <a class="btn btn-primary reveal d2" href="quote.html">Get a Quote</a>
    </div>
  </section>

</BaseLayout>
