---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Request Received — Lustique Co.";
const desc = "Your booking request is with Zandeline — she'll confirm and send your deposit link shortly.";
---
<BaseLayout slug="booking-received.html" title={title} desc={desc} robots="noindex">
  <section class="page-hero">
    <span class="eyebrow">Date request received</span>
    <h1>Your date is being held.</h1>
    <p id="refLine">Zandeline will confirm availability and send your deposit details — usually within a few hours.</p>
  </section>
  <section class="section"><div class="wrap prose">
    <p style="text-align:center;font-size:1.12rem;">Here's what happens next:</p>
    <ol style="max-width:46ch;margin:1.5rem auto;line-height:2.1;">
      <li>Zandeline reviews your request and confirms artist availability.</li>
      <li>Your date is held while we send your personalised quote and deposit link.</li>
      <li>Once the deposit is paid, your booking is confirmed — the balance follows the usual timeline.</li>
    </ol>
    <div style="display:grid;gap:1rem;max-width:48ch;margin:1.8rem auto;text-align:left;">
      <div style="border:1px solid #ece4da;border-radius:12px;padding:1rem 1.2rem;background:#fcf9f5;">
        <p style="margin:.1rem 0 .4rem;font-weight:600;color:var(--mocha);">Deposits secure the date</p>
        <p style="margin:0;font-size:.92rem;color:#5c5048;">A 50% booking fee locks your slot. The balance is due 14 business days before the wedding.</p>
      </div>
      <div style="border:1px solid #ece4da;border-radius:12px;padding:1rem 1.2rem;background:#fcf9f5;">
        <p style="margin:.1rem 0 .4rem;font-weight:600;color:var(--mocha);">Prefer to chat?</p>
        <p style="margin:0;font-size:.92rem;color:#5c5048;">You can also reach us on <a href="https://wa.me/27679253894" target="_blank" rel="noopener">WhatsApp</a> — we reply within a few hours.</p>
      </div>
    </div>
    <p class="note center" style="margin-top:2.4rem;">Blessings,<br>The Lustique Cosmetology Team</p>
  </div></section>

  <script is:inline>
    // Show the reference number if it was passed in the URL (?ref=LUS-2026-...)
    (function () {
      const params = new URLSearchParams(window.location.search);
      const ref = params.get("ref");
      if (ref && /^LUS-\d{4}-[A-Z0-9]+$/.test(ref)) {
        const line = document.getElementById("refLine");
        if (line) {
          line.innerHTML =
            "Your reference is <strong>" + ref + "</strong>. " +
            "Zandeline will confirm availability and send your deposit details — usually within a few hours.";
        }
      }
    })();
  </script>
</BaseLayout>
