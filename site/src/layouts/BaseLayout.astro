---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, OG_IMG, SITE_JSONLD, GA_MEASUREMENT_ID } from "../data/site";

interface Props { slug: string; title: string; desc: string; jsonld?: object; breadcrumb?: Array<{name: string; item?: string}>; robots?: "noindex"; }
const { slug, title, desc, jsonld, breadcrumb, robots } = Astro.props;
const breadcrumbJsonLd = breadcrumb ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    ...breadcrumb.map((crumb, i) => ({ "@type": "ListItem", position: i + 2, name: crumb.name, item: crumb.item ?? (SITE + "/" + slug) })),
  ],
} : null;
const canonical = `${SITE}/${slug === "index.html" ? "" : slug}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/logo.png" type="image/png" />
  <link rel="icon" href="/assets/logo.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lustique Co." />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={OG_IMG} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={OG_IMG} />
  {robots && <meta name="robots" content={robots} />}
  <meta name="theme-color" content="#A0625E" />
  <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>window.LUSTIQUE_GA_ID = gaId;</script>
  <script is:inline>
    (function(){var h=location.hash;if(h.includes('access_token=')&&h.includes('type=magiclink')){var p=new URLSearchParams(h.slice(1));var t=p.get('access_token');if(t)location.replace('/api/admin/auth/callback?access_token='+encodeURIComponent(t));}})();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(SITE_JSONLD)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header active={slug} />
  <main id="main"><slot /></main>
  <Footer />
  <div class="cookie-banner" id="cookieBanner" hidden>
    <p>We use a few cookies to make the site work and to understand how it’s used. <a href="privacy.html">Privacy &amp; cookies</a>.</p>
    <div class="cookie-actions"><button class="btn btn-ghost" id="cookieDecline">Decline</button><button class="btn btn-primary" id="cookieAccept">Accept</button></div>
  </div>
  <button class="to-top" id="toTop" aria-label="Back to top">↑</button>
  <script src="/site.js" is:inline></script>
</body>
</html>
