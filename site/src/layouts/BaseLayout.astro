---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, OG_IMG, SITE_JSONLD, GA_MEASUREMENT_ID } from "../data/site";

interface Props { slug: string; title: string; desc: string; jsonld?: object; breadcrumb?: Array<{name: string; item?: string}>; robots?: "noindex"; preloadImage?: string; ogImage?: string; businessJsonLdExtra?: object; }
const { slug, title, desc, jsonld, breadcrumb, robots, preloadImage, ogImage, businessJsonLdExtra } = Astro.props;
const shareImage = ogImage ?? OG_IMG;
// businessJsonLdExtra merges into the one LocalBusiness node (e.g. real Google review data on
// the homepage) rather than declaring a second, competing @id — only pass verified, real fields.
const localBusinessJsonLd = businessJsonLdExtra ? { ...SITE_JSONLD, ...businessJsonLdExtra } : SITE_JSONLD;
const breadcrumbJsonLd = breadcrumb ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + "/" },
    ...breadcrumb.map((crumb, i) => ({ "@type": "ListItem", position: i + 2, name: crumb.name, item: crumb.item ?? (SITE + "/" + slug) })),
  ],
} : null;
const canonical = `${SITE}/${slug === "index.html" ? "" : slug}`;
---
<!DOCTYPE html>
<html lang="en-GB" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/assets/logo.png" type="image/png" />
  <link rel="icon" href="/assets/logo.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lustique Co." />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={shareImage} />
  {robots && <meta name="robots" content={robots} />}
  <meta name="theme-color" content="#A0625E" />
  <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>window.LUSTIQUE_GA_ID = gaId;</script>
  <script is:inline>
    document.documentElement.classList.remove("no-js");
    (function(){var h=location.hash;if(h.includes('access_token=')&&h.includes('type=magiclink')){var p=new URLSearchParams(h.slice(1));var t=p.get('access_token');if(t)location.replace('/api/admin/auth/callback?access_token='+encodeURIComponent(t));}})();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" /></noscript>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header active={slug} />
  {breadcrumb && (
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <div class="wrap">
        <ol style="display: flex; align-items: center; font-size: clamp(0.78rem, 1vw, 0.85rem); color: var(--body-text-light)">
          <li><a href="index.html" style="color: var(--burgundy);">Home</a></li>
          {breadcrumb.map((crumb, i) => (
            <>
              <li aria-hidden="true">›</li>
              <li key={i}>
                {i === breadcrumb.length - 1
                  ? <span aria-current="page">{crumb.name}</span>
                  : <a href={crumb.item ?? "#"}>{crumb.name}</a>}
              </li>
            </>
          ))}
        </ol>
      </div>
    </nav>
  )}
  <main id="main"><slot /></main>
  <Footer />
  <div class="cookie-banner" id="cookieBanner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
    <p>We use a few cookies to make the site work and to understand how it’s used. <a href="privacy.html">Privacy &amp; cookies</a>.</p>
    <div class="cookie-actions"><button class="btn btn-ghost" id="cookieDecline">Decline</button><button class="btn btn-primary" id="cookieAccept">Accept</button></div>
  </div>
  <button class="to-top" id="toTop" aria-label="Back to top">↑</button>
  <script src="/site.js" is:inline></script>
</body>
</html>
