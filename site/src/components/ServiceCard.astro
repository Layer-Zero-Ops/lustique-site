---
// title/body/price may contain entities (e.g. "Editorial &amp; Photoshoot") — render raw for parity.
const { n, title, body, price } = Astro.props as { n: string; title: string; body: string; price: string };
---
<article class="card reveal" style="padding:2.1rem 1.9rem;">
  <span class="eyebrow">{n}</span>
  <h3 style="margin:.6rem 0 .6rem;" set:html={title} />
  <p set:html={body} />
  <p style="margin-top:1.5rem;font-family:var(--serif);font-size:1.3rem;color:var(--mocha);" set:html={price} />
</article>
