---
// title/body/price may contain entities (e.g. "Editorial &amp; Photoshoot") — render raw for parity.
const { n, title, body, price } = Astro.props as { n: string; title: string; body: string; price: string };
---
<article class="card reveal" >
  <span class="eyebrow">{n}</span>
  <h3  set:html={title} />
  <p set:html={body} />
  <p class="card-price" set:html={price} />
</article>
