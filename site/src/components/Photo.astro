---
interface Props {
  src: string;
  alt: string;
  cls?: string;
  eager?: boolean;
  width?: number;
  height?: number;
}

const { src, alt, cls = "", eager = false, width = 800, height = 800 } = Astro.props as Props;
---
<div class={`ph img ${cls}`}>
  <img
    class="ph-img"
    src={`assets/${src}`}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    width={width}
    height={height}
  />
</div>
