---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  cls?: string;
  eager?: boolean;
  width?: number;
  height?: number;
}

const { src, alt, cls = "", eager = false, width = 800, height = 800 } = Astro.props as Props;
---
<div class={`ph img ${cls}`}>
  <Image
    class="ph-img"
    src={src}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    width={width}
    height={height}
    formats={["avif", "webp"]}
  />
</div>
