---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  cls?: string;
  eager?: boolean;
  width?: number;
  height?: number;
  aspect?: "3/4" | "5/6" | "16/11" | "1/1";
}

const { src, alt, cls = "", eager = false, width = 800, height = 800, aspect = "3/4" } = Astro.props as Props;
---
<div class={`ph img ${cls}`} style={`aspect-ratio: ${aspect};`}>
  <Image
    class="ph-img"
    src={src}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    width={width}
    height={height}
    formats={["avif", "webp"]}
  />
</div>
