# Astro local dev env — copy to .env.local (gitignored via *.local rule).
# Points the site at the local Supabase instance started by `supabase start`.

# Supabase local instance (from `supabase start` output)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<local anon key from supabase start>
