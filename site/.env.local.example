# Astro local dev env — copy to .env.local (gitignored via *.local rule).
# Points the site at the local Supabase instance started by `supabase start`.

# Supabase local instance (from `supabase start` output)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<local anon key from supabase start>

# HERE Maps geocoding (venue finder on quote page)
# Production key: restrict to domain lustiqueco.co.za/* in HERE developer.here.com dashboard
PUBLIC_HERE_API_KEY=<your HERE API key>

# Google Places API (New) — pulls real Google Business Profile reviews onto the homepage
# at BUILD time (see src/lib/googleReviews.ts). Optional: if unset, the homepage falls back
# to the static TESTIMONIALS in src/data/site.ts — nothing breaks without these.
# Setup: Google Cloud Console -> new/existing project -> enable "Places API (New)" ->
# Credentials -> create an API key -> restrict it to the Places API only.
# Never prefix these with PUBLIC_ — they must stay server/build-side only.
GOOGLE_PLACES_API_KEY=<your Places API key>
# Find via https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=<Lustique Co.'s Google Place ID>
